{
  "name": "tauri-inventory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:tauri": "npm run tauri dev -w @tauri-inventory/pos",
    "dev:api": "npm run dev -w @tauri-inventory/api",
    "build:types": "npm run build -w @tauri-inventory/types"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "sharp@0.34.5": true,
    "better-sqlite3@12.11.1": true,
    "@journeyapps/sqlcipher@6.0.0": true,
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "esbuild": "^0.28.2",
    "node-gyp": "^13.0.2"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0"
  }
}
