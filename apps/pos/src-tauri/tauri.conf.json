{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-inventory",
  "version": "0.1.1",
  "identifier": "com.zen.tauri-inventory",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Celio Moveis",
        "width": 800,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMUFDREVCM0I4NkI1OTIKUldTU3RZWTc2ODBhUDJBSHA0alh4a1FSVW9QZllCS1lNZHNJK0g2Sm0zWHExb1EwNGVjeVk1WXgK",
      "endpoints": [
        "https://github.com/ryancelio/tauri-inventory/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
